# Sproutin API / Worker (NestJS) — 同一 image、不同 CMD (§20)
# api → start:prod（web service）；worker → start:worker（background worker，見 render.yaml）
FROM node:20-alpine AS base
# Prisma 在 Alpine 需 openssl；libc6-compat 提高相容性
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable
WORKDIR /app

FROM base AS deps
# tsconfig.base.json 必須一起複製：apps/api/tsconfig.json extends ../../tsconfig.base.json
# （含 strict:true）。少了它 → Docker build 失去 strict → zod z.infer 全欄位變 optional → TS2345。
# CI/本機有完整 repo 故不會發生;此檔為 Docker build context 對齊 CI 的關鍵。
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @sproutin/db generate
RUN pnpm --filter @sproutin/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3001
# 啟動前由 orchestrator 先跑 migrate:deploy (§23)
CMD ["pnpm", "--filter", "@sproutin/api", "start:prod"]
