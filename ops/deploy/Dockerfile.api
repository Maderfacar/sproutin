# Sproutin API (NestJS) — 同一 image 部署到所有學校，靠 env 區分 (§20)
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @sproutin/db generate
RUN pnpm --filter @sproutin/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3001
# 啟動前由 orchestrator 先跑 migrate:deploy (§23)
CMD ["pnpm", "--filter", "@sproutin/api", "start:prod"]
