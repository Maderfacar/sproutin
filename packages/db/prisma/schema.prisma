// ============================================================
// Sproutin — 各校 DB schema (§14-16) — Revised (修正 A/B/C/D/E)
// 單一 schema，部署到 N 個獨立 PostgreSQL (§19)。變更透過 migration (Rule 9)。
// SoT / Derived 見 docs/03-database-schema.md。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 租戶 / 組織（SoT）----------
model School {
  id        String        @id @default(cuid())
  name      String
  classes   Class[]
  config    SchoolConfig?
  createdAt DateTime      @default(now())
}

model SchoolConfig {
  id                    String  @id @default(cuid())
  schoolId              String  @unique
  school                School  @relation(fields: [schoolId], references: [id])
  brandName             String
  logoUrl               String?
  primaryColor          String  @default("#2E7D32")
  secondaryColor        String  @default("#A5D6A7")
  bannerUrl             String?
  cardOrder             Json // Dashboard card 排序 (§25)
  featureFlags          Json // { ai:false, health:false, bus:false, ... } (§26)
  leaveRequiresApproval Boolean @default(true) // 修正 A
  // --- per-school 版型/主題模板（Phase 8）---
  theme                 String  @default("warm") // 主題氛圍：warm | professional
  dashboardLayout       String  @default("grid") // Dashboard 版型：grid | list
  // --- 公開 runtime config（非機密，供 /config/public，ADR-001）---
  liffId                String? // 該校 LIFF ID（公開）
  lineOaChannelId       String? // LINE OA 公開 channel id
  lineOaBasicId         String? // LINE OA @basic id（公開）
  apiBaseUrl            String? // 瀏覽器面 API base（公開；預設 same-origin）
  // 機密（channel secret / token / JWT）不在此，由 secret manager 注入 env (ADR-004)
}

model Class {
  id       String              @id @default(cuid())
  schoolId String
  school   School              @relation(fields: [schoolId], references: [id])
  name     String
  students Student[]
  teachers TeacherAssignment[]
}

// ---------- 學生（核心聚合根，SoT）----------
model Student {
  id            String                   @id @default(cuid())
  classId       String
  class         Class                    @relation(fields: [classId], references: [id])
  name          String
  status        StudentStatus            @default(ACTIVE)
  guardianships Guardianship[]
  attendances   Attendance[]
  leaves        Leave[]
  messages      Message[]
  bookEntries   CommunicationBookEntry[]
  createdAt     DateTime                 @default(now())
}

// ---------- 身分 / 使用者（SoT；LINE ID 僅認證，修正 D）----------
model User {
  id           String              @id @default(cuid())
  displayName  String
  // 帳號啟用狀態（Phase 9 階段2 刀3）。停用＝不得登入；**不刪除帳號**，
  // 否則其建立的請假/訊息/稽核紀錄會失去歸屬。
  status       UserStatus          @default(ACTIVE)
  lineIdentity LineIdentity?
  roles        UserRole[]
  guardianOf   Guardianship[]
  teaching     TeacherAssignment[]
  bindingCodes BindingCode[]
  createdAt    DateTime            @default(now())
}

// ---------- LINE 綁定碼（SoT；Phase 9 階段3）----------
// 為什麼需要：園所後台建立的帳號只是「園所世界」的一筆資料，LINE 登入拿到的只是一串匿名
// userId，兩者之間沒有任何線索可自動對應（LINE 暱稱不可信、也不保證與真名有關）。
// 綁定碼＝園所簽發、由本人輸入一次的憑證，把這兩邊接起來；一個人一輩子只需做一次。
//
// 安全設計：
//   - code 為 8 碼（排除易混淆字元的 32 字母表 → 約 1.1×10^12 組合），單靠猜測不可行。
//   - 有期限（expiresAt）且用過即失效（usedAt），外流的紙本不會永久有效。
//   - 一組碼只綁一個 User；一個 LINE 帳號只能綁一個 User（LineIdentity.lineUserId 已 @unique）。
//   - 作廢＝revokedAt（保留紀錄供稽核，不刪除）。
model BindingCode {
  id               String    @id @default(cuid())
  code             String    @unique
  userId           String // 這組碼要綁給誰
  user             User      @relation(fields: [userId], references: [id])
  expiresAt        DateTime
  usedAt           DateTime?
  usedByLineUserId String? // 稽核用：實際是哪個 LINE 帳號用掉的
  revokedAt        DateTime? // 園所主動作廢（例如碼發錯人）
  createdBy        String
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// 園所的 LINE 圖文選單設計（Phase 9 階段3 ④）。一個對象一份設計。
// 設計（本表）與「已套用到 LINE 的那一份」（lineRichMenuId）刻意分開：
// LINE 的 API 不允許覆蓋既有選單的底圖 —— 換圖必須建新選單、把人綁過去、再刪舊的
// （官方後台的「換底圖」也是這樣做的，只是幫使用者藏起來了）。
// 加上「建立選單」有每小時 100 次的上限，因此**儲存設計不碰 LINE，只有「套用」才碰**。
model RichMenuConfig {
  id          String           @id @default(cuid())
  audience    RichMenuAudience @unique // 這份選單給誰看
  template    RichMenuTemplate @default(SIX)
  imageUrl    String? // 底圖（Vercel Blob）;LINE 限 JPEG/PNG、寬 800–2500、比例 ≥1.45、≤1MB
  chatBarText String           @default("開啟選單") // LINE 聊天列上的文字（LINE 限 14 字）
  items       Json             @default("[]") // [{ index, target }]；target 對應 App 內的功能

  // 已套用到 LINE 的那一份（用於下次套用時解除與清除，避免吃掉 1000 份的額度）
  lineRichMenuId String?
  appliedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RichMenuAudience {
  PARENT // 家長／監護人
  STAFF // 園長、行政、老師
  UNBOUND // 還沒綁定的人（只給一顆「開始使用」）
}

// 模板式（Human Owner 拍板）：園所換底圖 + 選每格連到哪，不做自由拉區域。
// 設計骨架鎖住＝填空題不是作文。LINE 一份選單最多 20 格，這裡遠低於上限。
enum RichMenuTemplate {
  SIX // 3×2 六格
  FOUR // 2×2 四格
  TWO // 1×2 兩格
}

// ---------- LINE 群發（Flex Message；Phase 9 階段3）----------
// **這張表存在的理由是「送出後無法收回」**：LINE 沒有提供撤回已送出推播的方法，因此每一次
// 群發都必須留下「誰、在什麼時候、把什麼內容、發給了多少人」的帳。沒有帳的話出事時
// 沒有人能回答家長「你們到底發了什麼給我」。
//
// 內容是**版型填空**（title/body/fields）而非自由 JSON —— 園所不寫 Flex JSON，
// 設計骨架鎖在程式裡（同圖文選單的策略：填空題不是作文）。
// status 刻意用自由字串（同 OutboxEvent）：日後增加狀態不需要 migration。
model PushCampaign {
  id       String               @id @default(cuid())
  template PushCampaignTemplate
  audience PushCampaignAudience
  classId  String? // audience=CLASS 時的班級

  title       String
  body        String
  imageUrl    String? // 選填一張圖（Vercel Blob；LINE 要求 https）
  buttonLabel String? // 選填按鈕的文字
  buttonUrl   String? // 按鈕連到哪（App 內頁的 LIFF 連結，或園所自填的 https 外部網址）
  fields      Json    @default("{}") // 版型專屬的顯示用文字（活動的日期地點、繳費的金額期限）

  // QUEUED（已排入，worker 尚未處理）→ SENDING → SENT / FAILED
  status String @default("QUEUED")
  // 失敗原因（給園長看得懂的一句話，例如「LINE 暫時無法連線」）。
  // 沒有這欄的話後台只能顯示「失敗」，園長無從判斷要不要重發（同圖文選單的教訓：
  // 把 LINE 的錯誤翻成看得懂的話，不要丟一個 INTERNAL_ERROR 出去）。
  failureReason String?

  // recipientCount = 建立當下算出的預估人數（給園長看的「會送出 N 則」）
  // sentCount / skippedCount = worker 實際送出時的結果（重新解析一次收件人才是真相）
  recipientCount Int @default(0)
  sentCount      Int @default(0)
  skippedCount   Int @default(0)

  createdBy String
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

enum PushCampaignTemplate {
  EVENT // 活動通知（日期地點 + 按鈕）
  PAYMENT // 繳費提醒（金額期限；**僅提醒，系統不記帳**）
  GENERAL // 一般通知
}

enum PushCampaignAudience {
  ALL_PARENTS // 全校家長／監護人
  CLASS // 指定班級的家長
  STAFF // 教職員（園長／行政／老師／隨車老師）
}

model LineIdentity {
  id         String @id @default(cuid())
  lineUserId String @unique // 僅供認證；不得作為業務外鍵 (修正 D)
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      Role
  scopeType ScopeType @default(SCHOOL)
  scopeId   String?
  @@unique([userId, role, scopeType, scopeId])
}

model Guardianship {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  relation  GuardianRelation
  isPrimary Boolean          @default(false)
  @@unique([userId, studentId])
}

model TeacherAssignment {
  id      String      @id @default(cuid())
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  classId String
  class   Class       @relation(fields: [classId], references: [id])
  role    TeacherRole @default(HOMEROOM)
  @@unique([userId, classId, role])
}

// ---------- Leave（SoT）+ 狀態機（修正 A）----------
model Leave {
  id         String      @id @default(cuid())
  studentId  String
  student    Student     @relation(fields: [studentId], references: [id])
  dateFrom   DateTime
  dateTo     DateTime
  reason     String
  status     LeaveStatus @default(PENDING) // PENDING/APPROVED/REJECTED/CANCELLED
  reviewedBy String? // 審核者 userId
  reviewNote String?
  createdBy  String // 申請者 userId
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ---------- Attendance（混合 SoT/Derived + override 政策，ADR-002）----------
model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  date         DateTime
  status       AttendanceStatus
  source       AttendanceSource @default(MANUAL) // 當前擁有者
  sourceRef    String? // source=LEAVE_EVENT 時的 active 來源 Leave.id
  derivedFrom  String? // 原始 Leave 血緣；override 後仍保留
  overriddenAt DateTime? // 由 Derived 被人工覆寫的時間
  overriddenBy String? // 覆寫者 userId
  @@unique([studentId, date])
}

// ---------- 溝通（Student-centered，修正 D；SoT）----------
model Message {
  id        String          @id @default(cuid())
  studentId String // 業務關聯以 Student 為核心，非 LINE ID
  student   Student         @relation(fields: [studentId], references: [id])
  classId   String
  senderId  String // userId
  category  MessageCategory @default(GENERAL)
  body      String
  reads     MessageRead[]
  createdAt DateTime        @default(now())
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  readAt    DateTime @default(now())
  @@unique([messageId, userId])
}

model Announcement {
  id        String            @id @default(cuid())
  schoolId  String
  classId   String? // null = 全校
  scope     AnnouncementScope
  title     String
  body      String
  createdBy String
  createdAt DateTime          @default(now())
}

// ---------- 每日聯絡簿（SoT；Phase 9 階段2 刀4）----------
// 每個學生、每一天一筆（@@unique）。**只存「老師記錄的當日觀察」**：
//   - 出缺勤 / 請假不存在這裡（各自為 SoT，見 Attendance / Leave）；本表只借 arrivalTime 記到校時刻。
//   - 親師對話不存在這裡（沿用 Message，Student-centered）；本表只存老師的當日留言。
//   - 過敏原 / 用藥委託 / 成長曲線屬未來「幼兒健康」模組的長期資料，不放本表（修正 B）。
// 沒有列 = 當日未記錄（家長端顯示「未記錄」，非錯誤）。publishedAt = null 代表老師尚未送出。
model CommunicationBookEntry {
  id          String          @id @default(cuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id])
  date        DateTime // 當日零點（UTC），與 Attendance 同慣例
  arrivalTime String? // "HH:mm" 園所當地牆上時間；由點名（check-in）帶入
  lunch       MealAmount?
  snack       MealAmount?
  nap         NapQuality?
  toilet      ToiletState?
  mood        Mood?
  symptoms    HealthSymptom[] // 可複選；空陣列 = 無異狀
  temperature Float? // 攝氏，選填；只有實際量過才有值
  pickup      PickupMethod?
  teacherNote String?
  filledBy    String? // 最後填寫者 userId
  filledAt    DateTime?
  publishedAt DateTime? // 送出給家長的時間；null = 尚未送出
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

// ---------- Notification（Derived）----------
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------- Audit Log（SoT, append-only，修正 C）----------
model AuditLog {
  id           String      @id @default(cuid())
  actorUserId  String? // 誰（system 為 null）
  actorRole    String?
  action       String // 什麼 Action，如 "leave.approve"
  resourceType String // 對哪個資源，如 "Student"/"Leave"/"Message"
  resourceId   String?
  result       AuditResult // 結果
  scopeType    String?
  scopeId      String?
  metadata     Json? // 摘要/IP；不存敏感明文（健康、訊息內容）
  createdAt    DateTime    @default(now()) // 何時
  @@index([resourceType, resourceId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ---------- Transactional Outbox（§4）----------
model OutboxEvent {
  id           String    @id @default(cuid())
  eventType    String
  payload      Json
  status       String    @default("PENDING") // PENDING / DISPATCHED / FAILED
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
}

// 註：Health/Bus 等未來 model 不預建（修正 B），需要時再以 migration 加入。

// ---------- Enums ----------
enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  BUS_TEACHER
  PARENT
  GUARDIAN
}

enum ScopeType {
  SCHOOL
  CLASS
}

enum GuardianRelation {
  FATHER
  MOTHER
  GRANDPARENT
  GUARDIAN
}

enum TeacherRole {
  HOMEROOM
  BUS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum AttendanceSource {
  MANUAL
  LEAVE_EVENT
}

enum MessageCategory {
  GENERAL
  HEALTH
  BEHAVIOR
  ADMIN
}

enum AnnouncementScope {
  SCHOOL
  CLASS
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// ---- 每日聯絡簿的選項（刀4）。順序即 UI 由「最順利」到「最需注意」。----
enum MealAmount {
  ALL // 吃完
  MOST // 大部分
  HALF // 一半
  LITTLE // 少許
  NONE // 沒吃
}

enum NapQuality {
  WELL // 睡得好
  SHORT // 睡一下下
  NONE // 沒睡
}

enum ToiletState {
  NORMAL // 正常
  LOOSE // 軟便
  HARD // 硬便
  NONE // 今天沒有
}

enum Mood {
  HAPPY // 開心
  CALM // 平穩
  SLEEPY // 想睡
  LOW // 情緒低落
}

// 當日健康觀察（可複選）。長期健康資料屬未來「幼兒健康」模組，不在此列舉。
enum HealthSymptom {
  COUGH // 咳嗽
  RUNNY_NOSE // 流鼻水
  SORE_THROAT // 喉嚨不適
  DIARRHEA // 腹瀉
  VOMITING // 嘔吐
  POOR_APPETITE // 食慾不振
  LOW_ENERGY // 精神不濟
  RASH // 皮膚疹
}

enum PickupMethod {
  FAMILY // 家人接送
  SCHOOL_BUS // 校車
}
