# ============================================================
# Sproutin — 每校 Instance 環境變數範本 (§19 每校獨立注入)
# 同一份 image + 不同 env = 不同學校。切勿把真值提交進 git。
#
# 機密值（DB 憑證 / LINE secret / JWT）正式環境一律來自 Secret Manager，
# Control Plane 只存其 reference（ADR-004）；此檔僅供本機開發填入。
# per-school 的公開設定（LIFF ID / branding）正式環境存於該校 DB 的
# SchoolConfig，經 /config/public 於 runtime 提供（ADR-001），非 build-time 內嵌。
# ============================================================

# --- 該校獨立資料庫 (§19；正式環境來自 databaseSecretRef) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sproutin_schoolA"

# --- 該校 Redis (cache / queue) ---
REDIS_URL="redis://localhost:6379"

# --- LINE OA / LIFF（機密：正式環境來自 lineSecretRef）---
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# --- Auth（機密：正式環境來自 jwtSecretRef）---
JWT_SECRET="change-me-per-instance"
JWT_EXPIRES_IN="7d"

# --- API (server runtime) ---
API_PORT="3001"
SCHOOL_SLUG="school-a"          # 本 instance 識別 (ADR-001)

# --- Web (server runtime；非 NEXT_PUBLIC_，避免 build-time 內嵌 per-school 值) ---
# 瀏覽器改打 same-origin /api/public-config，故此處為伺服器端內部連線用
API_INTERNAL_URL="http://api:3001"
WEB_PORT="3000"

# ============================================================
# Control Plane (跨校中繼，獨立部署，只存 metadata + secret reference)
# ============================================================
CONTROL_PLANE_DATABASE_URL="postgresql://user:password@localhost:5432/sproutin_control_plane"
