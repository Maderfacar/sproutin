{
  "name": "sproutin",
  "version": "0.1.0",
  "private": true,
  "description": "Sproutin — 幼兒園校務管理與家長溝通 SaaS (LINE OA + LIFF)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sproutin/db generate",
    "db:migrate": "pnpm --filter @sproutin/db migrate",
    "db:migrate:deploy": "pnpm --filter @sproutin/db migrate:deploy",
    "db:seed": "pnpm --filter @sproutin/db seed",
    "db:verify": "pnpm --filter @sproutin/db verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
